# Copy to .env and fill in. .env is gitignored; this file is not.
PAYLOAD_SECRET=generate-a-long-random-string
DATABASE_URI=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres: use the pooled (-pooler) connection string.
# Neon Object Storage (S3 API): bucket plus a storage:read/write credential
# (Neon console > Connect > Storage). Leave S3_ACCESS_KEY_ID blank to store
# uploads on local disk instead.
S3_BUCKET=iris
S3_REGION=us-east-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google sign-in. Leave blank and the Google buttons simply do not render.
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing mail. Leave SMTP_HOST blank and Payload logs emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@irisgarden.com

# Only read by `npm run seed`. Always set these when seeding a deployed site.
SEED_EMAIL=
SEED_PASSWORD=
# Vercel only: set to any value for ONE build to seed the database, then remove it.
# The seed wipes products, categories and media.
SEED_ON_BUILD=
