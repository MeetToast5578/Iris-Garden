# Copy to .env and fill in. .env is gitignored; this file is not.
PAYLOAD_SECRET=generate-a-long-random-string
DATABASE_URI=file:./iris-garden.db
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in. Leave blank and the Google buttons simply do not render.
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing mail. Leave SMTP_HOST blank and Payload logs emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@irisgarden.com

# Only read by `npm run seed`. Always set these when seeding a deployed site.
SEED_EMAIL=
SEED_PASSWORD=
